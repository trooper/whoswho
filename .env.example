# whoswho configuration. Copy to .env and uncomment what you need (.env is git-ignored).
# Variables already set in the shell environment win over this file.

# Port to listen on (all interfaces).
# PORT=3000

# SQLite database file.
# DB_PATH=./whoswho.sqlite

# Password for /hax0r and the admin API (HTTP Basic auth, any username).
# Unset means the admin page is open to anyone on the network.
# ADMIN_PASSWORD=

# Host or IP to put in the QR code, if the auto-detected LAN IP is wrong
# (e.g. a VPN interface gets picked).
# PUBLIC_HOST=

# Full public address to put in the QR code when the app is reached from
# outside the network, e.g. through a Cloudflare tunnel. Usually not needed:
# a page opened through a tunnel already uses the tunnel's address.
# PUBLIC_URL=https://party.example.com

